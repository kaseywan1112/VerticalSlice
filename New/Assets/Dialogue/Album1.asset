  lines:
  - speakerName: You
    portrait: {fileID: 0}
    text: Wait.... A picture
  - speakerName: You
    portrait: {fileID: 0}
    text: It is Chicken Grandpa and Chicken Grandson.
  - speakerName: You
    portrait: {fileID: 0}
    text: There is something written on the back.
  - speakerName: You
    portrait: {fileID: 0}
    text: "\u201CMy grandson loves pizza more than anything.\u201D"
  - speakerName: You
    portrait: {fileID: 0}
    text: "\u201CThe last time we fought, it was my fault.\u201D"
  - speakerName: You
    portrait: {fileID: 0}
    text: "\u201CBut I was stubborn. I told myself I would never go back.\u201D"
  - speakerName: You
    portrait: {fileID: 0}
    text: "\u201CSo... I regret a lot.\u201D"
  - speakerName: You
    portrait: {fileID: 0}
    text: "\u201CI just hope I can see my grandson one more time.\u201D"
  - speakerName: You
    portrait: {fileID: 0}
    text: ...
  options: []

  m_Script: {fileID: 11500000, guid: b1c3cae70ad8d9641a4b5be915b33736, type: 3}
  m_Name: Album1
  m_EditorClassIdentifier: 
  lines:
  - speakerName: You
    portrait: {fileID: 21300000, guid: 139664e598056644193b46fd8e8d34e3, type: 3}
    text: Wait.... A picture
  - speakerName: You
    portrait: {fileID: 21300000, guid: c347e233790817342891cf3a95ba10e5, type: 3}
    text: It is Chicken Grandpa and Chicken Grandson.
  - speakerName: You
    portrait: {fileID: 21300000, guid: 139664e598056644193b46fd8e8d34e3, type: 3}
    text: There is something written on the back.
  - speakerName: You
    portrait: {fileID: 21300000, guid: 27bb86a2fbee45249b8fdf4deb810f7a, type: 3}
    text: "\u201CMy grandson loves pizza more than anything.\u201D"
  - speakerName: You
    portrait: {fileID: 21300000, guid: 27bb86a2fbee45249b8fdf4deb810f7a, type: 3}
    text: "\u201CThe last time we fought, it was my fault.\u201D"
  - speakerName: You
    portrait: {fileID: 21300000, guid: 27bb86a2fbee45249b8fdf4deb810f7a, type: 3}
    text: "\u201CBut I was stubborn. I told myself I would never go back.\u201D"
  - speakerName: You
    portrait: {fileID: 21300000, guid: c347e233790817342891cf3a95ba10e5, type: 3}
    text: "\u201CSo... I regret a lot.\u201D"
  - speakerName: You
    portrait: {fileID: 21300000, guid: c347e233790817342891cf3a95ba10e5, type: 3}
    text: "\u201CI just hope I can see my grandson one more time.\u201D"
  - speakerName: You
    portrait: {fileID: 21300000, guid: c347e233790817342891cf3a95ba10e5, type: 3}
    text: ...
  options: []

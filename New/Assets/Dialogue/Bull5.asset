  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b1c3cae70ad8d9641a4b5be915b33736, type: 3}
  m_Name: Bull5
  m_EditorClassIdentifier: 
  lines:
  - speakerName: You
    portrait: {fileID: 21300000, guid: 139664e598056644193b46fd8e8d34e3, type: 3}
    text: You said you can grant one wish.
  - speakerName: Genie
    portrait: {fileID: 21300000, guid: 5be961f9a5bb06b4d95efb058e8ee00f, type: 3}
    text: Yes, after you help me.
  - speakerName: You
    portrait: {fileID: 21300000, guid: c94401dbaeda7ba41b8f6b821553714a, type: 3}
    text: That was not in the contract.
  - speakerName: Genie
    portrait: {fileID: 21300000, guid: 5be961f9a5bb06b4d95efb058e8ee00f, type: 3}
    text: There is no contract. This is a magical lamp.
  - speakerName: You
    portrait: {fileID: 21300000, guid: 787fafedeaa52fc4a96a9263c592c76e, type: 3}
    text: "So I don\u2019t have a choice?"
  - speakerName: Genie
    portrait: {fileID: 21300000, guid: c8ae8ad4b19d4d245815a4d418701c43, type: 3}
    text: You have choices. You can go up the hill now, or you can go up the hill
      after complaining.
  - speakerName: You
    portrait: {fileID: 21300000, guid: 787fafedeaa52fc4a96a9263c592c76e, type: 3}
    text: Fine..
  options: []

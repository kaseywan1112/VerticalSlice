  lines:
  - speakerName: You
    portrait: {fileID: 21300000, guid: 27bb86a2fbee45249b8fdf4deb810f7a, type: 3}
    text: "Is this chicken grandpa\u2019s grave?"
  - speakerName: Little Ghost
    portrait: {fileID: 21300000, guid: 218ab3ac7456d2f4b834dc4ced4c8cd5, type: 3}
    text: No. This is my grave.
  - speakerName: Little Ghost
    portrait: {fileID: 21300000, guid: 218ab3ac7456d2f4b834dc4ced4c8cd5, type: 3}
    text: You came to the wrong dead guy.
  - speakerName: Little Ghost
    portrait: {fileID: 21300000, guid: 218ab3ac7456d2f4b834dc4ced4c8cd5, type: 3}
    text: You came to the wrong dead guy.

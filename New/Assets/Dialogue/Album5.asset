  lines:
  - speakerName: 'Chicken '
    portrait: {fileID: 21300000, guid: 26b7c805062432147828c3abd54b6aea, type: 3}
    text: WAIT!
  - speakerName: 'Chicken '
    portrait: {fileID: 21300000, guid: 26b7c805062432147828c3abd54b6aea, type: 3}
    text: Please.
  - speakerName: 'Chicken '
    portrait: {fileID: 21300000, guid: f9206739d0fdeb04a93e48371b1f0a65, type: 3}
    text: Can I have the wish?
  - speakerName: You
    portrait: {fileID: 21300000, guid: 787fafedeaa52fc4a96a9263c592c76e, type: 3}
    text: You followed us here?
  - speakerName: Genie
    portrait: {fileID: 21300000, guid: 4a065c356b09ccf4ab23f3ffd7b568e5, type: 3}
    text: This is not your wish.
  - speakerName: Chicken
    portrait: {fileID: 21300000, guid: 917f271717e1f3a4aba68da5138d20ca, type: 3}
    text: I know, but please. You know what I want.
  - speakerName: You
    portrait: {fileID: 21300000, guid: 787fafedeaa52fc4a96a9263c592c76e, type: 3}
    text: "I really don\u2019t like where this is going."
  options:
  - speakerName: You
    portrait: {fileID: 21300000, guid: 27bb86a2fbee45249b8fdf4deb810f7a, type: 3}
    replyText: What do you even want?
    nextNode: {fileID: 11400000, guid: 25a05823afb076241b05a4968110bd0d, type: 2}
  - speakerName: You
    portrait: {fileID: 0}
    replyText: No. This is my wish.
    nextNode: {fileID: 11400000, guid: cb2808b0135329c4387b394be5e8db06, type: 2}
  - speakerName: You
    portrait: {fileID: 0}
    replyText: Fine. Give him the wish.
    nextNode: {fileID: 11400000, guid: 2e861f5f0bff54548a9b867a1416d76a, type: 2}
  - speakerName: You
    portrait: {fileID: 0}
    replyText: Yea...Make your Wish

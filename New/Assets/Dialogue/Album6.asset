  lines:
  - speakerName: Chicken
    portrait: {fileID: 0}
    text: I wish
  - speakerName: Chicken
    portrait: {fileID: 0}
    text: I wish!!!
  - speakerName: Chicken
    portrait: {fileID: 0}
    text: I wish!!!!!!!!!!!!!!
  - speakerName: Chicken
    portrait: {fileID: 0}
    text: For pizza
  - speakerName: Genie
    portrait: {fileID: 0}
    text: ...
  - speakerName: You
    portrait: {fileID: 0}
    text: ...
  - speakerName: Chicken
    portrait: {fileID: 0}
    text: My delivery never came.
  - speakerName: Genie
    portrait: {fileID: 0}
    text: That is your wish?
  - speakerName: Chicken
    portrait: {fileID: 0}
    text: Yes.
  - speakerName: You
    portrait: {fileID: 0}
    text: "What the f**k is that wish\u2026"
  - speakerName: Genie
    portrait: {fileID: 0}
    text: Wish granted.
  - speakerName: You
    portrait: {fileID: 0}
    text: ARE YOU F**KING SERIOUS?
  - speakerName: You
    portrait: {fileID: 0}
    text: YOU WASTED MY ONE WISH ON A PIZZA?
  - speakerName: Chicken
    portrait: {fileID: 0}
    text: Can we eat now?
  - speakerName: You
    portrait: {fileID: 0}
    text: A SINGLE PIZZA?
  - speakerName: You
    portrait: {fileID: 0}
    text: "WE WALKED ALL THE WAY HERE, TALKED TO A RANDOM GHOST, FOUND YOUR GRANDPA\u2019S
      GRAVE, READ HIS SAD LITTLE PHOTO MESSAGE, AND YOU USED THE WISH FOR PIZZA?"
  - speakerName: Chicken
    portrait: {fileID: 0}
    text: I was hungry.
  - speakerName: You
    portrait: {fileID: 0}
    text: YOUR GRANDPA WANTED TO SEE YOU ONE MORE TIME!
  - speakerName: You
    portrait: {fileID: 0}
    text: DO YOU NOT MISS YOUR GRANDPA?
  - speakerName: Chicken
    portrait: {fileID: 0}
    text: I do.
  - speakerName: You
    portrait: {fileID: 0}
    text: WHAT THE F*** IS WRONG WITH THIS PLACE?
  - speakerName: You
    portrait: {fileID: 0}
    text: ...
  - speakerName: Chicken
    portrait: {fileID: 0}
    text: Do you guys want a slice?
  - speakerName: You
    portrait: {fileID: 0}
    text: ...
  options: []

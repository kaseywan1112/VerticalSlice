  lines:
  - speakerName: Genie
    portrait: {fileID: 21300000, guid: 37e91a4387ef267498d82d5f65a8a476, type: 3}
    text: Excuse me?
  - speakerName: You
    portrait: {fileID: 21300000, guid: 139664e598056644193b46fd8e8d34e3, type: 3}
    text: I said mooo. I thought that was your language.
  - speakerName: Genie
    portrait: {fileID: 21300000, guid: 13ce2952864f8e24f9ca6c3f18f88804, type: 3}
    text: Wow. That is so racist.
  - speakerName: You
    portrait: {fileID: 21300000, guid: c347e233790817342891cf3a95ba10e5, type: 3}
    text: Wait, what? I was just trying to be friendly.
  - speakerName: Genie
    portrait: {fileID: 21300000, guid: 37e91a4387ef267498d82d5f65a8a476, type: 3}
    text: "Not because I am a cow means you can just walk up to me and say \u201Cmooo.\u201D"
